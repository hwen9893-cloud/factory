# Copy to .env. Never commit .env.
#
# Keys stay in the process environment. Do not put them in:
#   factory.yaml, config/local.yaml, project.yaml, novel.json, or Git.
# The GUI (Models / Settings) only detects whether these names exist.
# It never displays or writes the secret values. Generation/memory knobs
# go to config/local.yaml — still no keys there.
#
# Model names belong in YAML (config/default.yaml or factory.yaml), not here.

# Qwen / DashScope (OpenAI-compatible). Fallback if empty: QWEN_API_KEY
DASHSCOPE_API_KEY=
# QWEN_API_KEY=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini. Fallback if empty: GOOGLE_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=

OPENROUTER_API_KEY=

# Optional process overrides (later than YAML, earlier than CLI --provider / --config)
FACTORY_PROVIDER=mock
# FACTORY_BOOK=demo
# FACTORY_DATA_DIR=data/books
# FACTORY_CONFIG=/absolute/path/to/factory.yaml
# FACTORY_LANGUAGE=zh-CN
# FACTORY_CHAPTER_TARGET_WORDS=5000
# FACTORY_MAX_REVISION_ROUNDS=2
# FACTORY_STORAGE_BACKEND=json
# FACTORY_RECENT_CHAPTERS=3
# FACTORY_MODEL_ARCHITECT=
# FACTORY_MODEL_PLANNER=
# FACTORY_MODEL_WRITER=
# FACTORY_MODEL_REVIEWER=
